[Unit]
Description=agentLIBRE terminal runtime
Requires=agl-terminald.socket
After=agl-terminald.socket
Before=agentlibre-daemon.service

[Service]
Type=simple
EnvironmentFile=%h/.config/agl-terminal/service.env
Environment=AGL_TERMINALD_SYSTEMD_ACTIVATION=1
ExecStart=%h/.local/bin/agl-terminald
Restart=on-failure
RestartSec=2
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/.local/share/agl-terminal %h/.local/state/agl-terminal %t/agl-terminal

[Install]
WantedBy=default.target
