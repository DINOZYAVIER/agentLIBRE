+        const auto* nextn = gguf.get("qwen4exp.nextn_predict_layers");
+        if (!blocks || !nextn || !nextn->is_num() || nextn->u == 0 || nextn->u >= blocks->u) return -1;
+        return (int64_t) (blocks->u - nextn->u);
+    }
+    return -1;
+}
