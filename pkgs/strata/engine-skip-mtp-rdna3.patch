+int64_t mtp_trunk(const std::vector<std::string>& shards) {
+    for (const auto& path : shards) {
+        strata::GgufFile gguf(path);
+        const auto* arch = gguf.get("general.architecture");
+        if (!arch) continue;
+        if (arch->s != "qwen4exp") return -1;
