{
  "type": "object",
  "additionalProperties": false,
  "required": ["path", "cursor", "limit_lines"],
  "properties": {
    "path": { "type": "string", "minLength": 1 },
    "cursor": {
      "type": "integer",
      "minimum": 1,
      "description": "First line to return. Use 1 for the first page and the exact next_cursor for continuation; never repeat the same path and cursor."
    },
    "limit_lines": {
      "type": "integer",
      "minimum": 1,
      "maximum": 500,
      "description": "Maximum lines in this page."
    }
  }
}
