{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "action": {
          "const": "start"
        },
        "argv": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "items": {
            "type": "string",
            "maxLength": 32768
          }
        },
        "cwd": {
          "type": "string"
        },
        "timeout_ms": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3600000
        },
        "max_output_bytes": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "action",
        "argv"
      ]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "action": {
          "const": "inspect"
        },
        "execution_id": {
          "type": "string",
          "pattern": "^exec_"
        }
      },
      "required": [
        "action",
        "execution_id"
      ]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "action": {
          "const": "read"
        },
        "execution_id": {
          "type": "string",
          "pattern": "^exec_"
        },
        "stream": {
          "enum": [
            "stdout",
            "stderr"
          ]
        },
        "offset": {
          "type": "integer",
          "minimum": 0
        },
        "max_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1048576
        }
      },
      "required": [
        "action",
        "execution_id",
        "stream"
      ]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "action": {
          "const": "wait"
        },
        "execution_id": {
          "type": "string",
          "pattern": "^exec_"
        },
        "wait_timeout_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3600000
        }
      },
      "required": [
        "action",
        "execution_id",
        "wait_timeout_ms"
      ]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "action": {
          "const": "stop"
        },
        "execution_id": {
          "type": "string",
          "pattern": "^exec_"
        }
      },
      "required": [
        "action",
        "execution_id"
      ]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "action": {
          "const": "cleanup"
        },
        "execution_id": {
          "type": "string",
          "pattern": "^exec_"
        }
      },
      "required": [
        "action",
        "execution_id"
      ]
    }
  ]
}
