{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["argv"],
  "properties": {
    "argv": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "prefixItems": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]*$"
        }
      ],
      "items": { "type": "string", "maxLength": 32768 }
    },
    "cwd": { "type": "string", "minLength": 1, "maxLength": 32768 },
    "timeout_ms": { "type": "integer", "minimum": 1, "maximum": 3600000 },
    "max_output_bytes": { "type": "integer", "minimum": 1, "maximum": 16777216 }
  }
}
