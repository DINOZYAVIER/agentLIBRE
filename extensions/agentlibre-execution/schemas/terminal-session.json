{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["action", "argv"],
      "properties": {
        "action": { "const": "open" },
        "argv": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "prefixItems": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]*$"
            }
          ],
          "items": { "type": "string", "maxLength": 32768 }
        },
        "cwd": { "type": "string", "minLength": 1, "maxLength": 32768 },
        "rows": { "type": "integer", "minimum": 1, "maximum": 1000 },
        "columns": { "type": "integer", "minimum": 1, "maximum": 1000 }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["action", "terminal_id"],
      "properties": {
        "action": { "enum": ["inspect", "interrupt", "terminate"] },
        "terminal_id": { "$ref": "#/$defs/terminal_id" }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["action", "terminal_id"],
      "properties": {
        "action": { "const": "read" },
        "terminal_id": { "$ref": "#/$defs/terminal_id" },
        "after": { "type": "integer", "minimum": 0 },
        "max_bytes": { "type": "integer", "minimum": 1, "maximum": 1048576 }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["action", "terminal_id", "input"],
      "properties": {
        "action": { "const": "write" },
        "terminal_id": { "$ref": "#/$defs/terminal_id" },
        "input": { "type": "string", "maxLength": 1048576 }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["action", "terminal_id", "rows", "columns"],
      "properties": {
        "action": { "const": "resize" },
        "terminal_id": { "$ref": "#/$defs/terminal_id" },
        "rows": { "type": "integer", "minimum": 1, "maximum": 1000 },
        "columns": { "type": "integer", "minimum": 1, "maximum": 1000 }
      }
    }
  ],
  "$defs": {
    "terminal_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^term_[A-Za-z0-9_-]+$"
    }
  }
}
